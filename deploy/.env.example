# Production configuration. Lives ONLY on the droplet at /opt/astralis/deploy/.env
#   cp .env.example .env && chmod 600 .env
# Never commit the filled-in copy. Values with spaces or < > must be quoted.

# ---------- Where it runs ----------
DOMAIN=astralis.example.dev
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com
# Your GitHub username, lowercase — images are ghcr.io/<this>/astralis-*
GHCR_OWNER=your-github-username
TAG=latest

# ---------- Database ----------
# Hex only: this is interpolated into a URL, where + / = would break parsing.
#   openssl rand -hex 24
POSTGRES_USER=astralis
POSTGRES_PASSWORD=
POSTGRES_DB=astralis

# ---------- Sign-in ----------
#   openssl rand -base64 48
AUTH_SECRET=
RESEND_API_KEY=
# Must be an address on the domain you verified in Resend.
MAIL_FROM="Astralis <signin@astralis.example.dev>"
RATE_LIMIT_PER_MIN=20
AUTH_RATE_LIMIT_PER_MIN=10

# ---------- Models ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
SAFETY_THRESHOLD=0.55

# ---------- Research ----------
OPENALEX_MAILTO=you@example.com

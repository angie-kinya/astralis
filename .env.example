# Postgres
POSTGRES_USER=astralis
POSTGRES_PASSWORD=astralis_dev_pw
POSTGRES_DB=astralis
DATABASE_URL=postgres://astralis:astralis_dev_pw@localhost:5432/astralis?sslmode=disable

# Redis (Asynq queue) 
REDIS_ADDR=localhost:6379

# Gateway 
PORT=8080
ENV=development
BACKEND_JWT_SECRET=change-me-openssl-rand-base64-48
CORS_ORIGIN=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-5

# Embeddings
# EMBED_DIM must match the VECTOR(n) column in db/migrations/0001_init.sql.
# Changing the model means a new migration and a full re-embed -- vectors from
# different models are not comparable.
EMBED_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxx
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Safety
# Leave SAFETY_CLASSIFIER_URL empty to run on rules alone; the filter degrades
# to rules-only rather than failing.
SAFETY_CLASSIFIER_URL=http://localhost:8000
SAFETY_THRESHOLD=0.55

# Rate limiting
RATE_LIMIT_PER_MIN=20

# Research ingestion
# OpenAlex asks that you identify yourself
OPENALEX_MAILTO=you@example.com

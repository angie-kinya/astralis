# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env
# Values containing spaces or < > must be quoted, so the file can be sourced.

# ---------- Postgres ----------
POSTGRES_USER=astralis
POSTGRES_PASSWORD=astralis_dev_pw
POSTGRES_DB=astralis
DATABASE_URL=postgres://astralis:astralis_dev_pw@localhost:5432/astralis?sslmode=disable

# ---------- Queue (optional) ----------
# Leave empty to run without Redis: cmd/summarise writes session memory on a
# schedule instead. Only cmd/worker needs this.
REDIS_ADDR=

# ---------- API ----------
PORT=8080
ENV=development
# Keys the HMAC over sign-in codes. At least 32 characters.
#   openssl rand -base64 48
AUTH_SECRET=change-me-openssl-rand-base64-48
RATE_LIMIT_PER_MIN=20
AUTH_RATE_LIMIT_PER_MIN=10

# ---------- Email sign-in ----------
# Empty locally: sign-in codes are printed in the `make api` terminal instead.
# Required in production (the API refuses to start without it).
RESEND_API_KEY=
MAIL_FROM="Astralis <onboarding@resend.dev>"
# Returns the code in the API response so scripts/smoke.sh can sign in.
# Development only — the API refuses to start with it in production.
AUTH_DEV_ECHO_CODE=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Verify current model ids at docs.claude.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-5

# ---------- Embeddings ----------
# EMBED_DIM must match VECTOR(n) in db/migrations/0001_init.sql.
EMBED_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxx
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ---------- Safety ----------
SAFETY_CLASSIFIER_URL=http://localhost:8000
SAFETY_THRESHOLD=0.55

# ---------- Research ingestion ----------
OPENALEX_MAILTO=you@example.com
